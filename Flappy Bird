import pygame
import random
import sys

pygame.init()

# Screen settings
WIDTH = 500
HEIGHT = 700
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Flappy Bird")

clock = pygame.time.Clock()
FPS = 60

# Colors
SKY_BLUE = (135, 206, 235)
GREEN = (0, 180, 0)
DARK_GREEN = (0, 120, 0)
YELLOW = (255, 220, 0)
ORANGE = (255, 140, 0)
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)

# Fonts
font = pygame.font.SysFont("Arial", 36)
small_font = pygame.font.SysFont("Arial", 24)

# Bird settings
bird_x = 100
bird_y = HEIGHT // 2
bird_radius = 18
bird_velocity = 0
gravity = 0.45
flap_strength = -8

# Pipe settings
pipe_width = 80
pipe_gap = 180
pipe_speed = 4
pipes = []

# Ground
ground_height = 80

# Game state
score = 0
game_over = False


def create_pipe():
    min_top = 80
    max_top = HEIGHT - ground_height - pipe_gap - 80
    top_height = random.randint(min_top, max_top)

    pipe = {
        "x": WIDTH,
        "top_height": top_height,
        "passed": False
    }

    return pipe


def reset_game():
    global bird_y, bird_velocity, pipes, score, game_over

    bird_y = HEIGHT // 2
    bird_velocity = 0
    pipes = [create_pipe()]
    score = 0
    game_over = False


def draw_bird():
    pygame.draw.circle(screen, YELLOW, (bird_x, int(bird_y)), bird_radius)
    pygame.draw.circle(screen, ORANGE, (bird_x + 10, int(bird_y) + 3), 5)
    pygame.draw.circle(screen, BLACK, (bird_x + 6, int(bird_y) - 6), 3)


def draw_pipes():
    for pipe in pipes:
        x = pipe["x"]
        top_height = pipe["top_height"]

        # Top pipe
        pygame.draw.rect(screen, GREEN, (x, 0, pipe_width, top_height))
        pygame.draw.rect(screen, DARK_GREEN, (x, top_height - 20, pipe_width, 20))

        # Bottom pipe
        bottom_y = top_height + pipe_gap
        bottom_height = HEIGHT - ground_height - bottom_y
        pygame.draw.rect(screen, GREEN, (x, bottom_y, pipe_width, bottom_height))
        pygame.draw.rect(screen, DARK_GREEN, (x, bottom_y, pipe_width, 20))


def move_pipes():
    global score

    for pipe in pipes:
        pipe["x"] -= pipe_speed

        if not pipe["passed"] and pipe["x"] + pipe_width < bird_x:
            pipe["passed"] = True
            score += 1

    if pipes[-1]["x"] < WIDTH - 250:
        pipes.append(create_pipe())

    if pipes[0]["x"] + pipe_width < 0:
        pipes.pop(0)


def check_collision():
    bird_rect = pygame.Rect(
        bird_x - bird_radius,
        bird_y - bird_radius,
        bird_radius * 2,
        bird_radius * 2
    )

    # Ground collision
    if bird_y + bird_radius >= HEIGHT - ground_height:
        return True

    # Ceiling collision
    if bird_y - bird_radius <= 0:
        return True

    # Pipe collision
    for pipe in pipes:
        x = pipe["x"]
        top_height = pipe["top_height"]
        bottom_y = top_height + pipe_gap

        top_pipe_rect = pygame.Rect(x, 0, pipe_width, top_height)
        bottom_pipe_rect = pygame.Rect(
            x,
            bottom_y,
            pipe_width,
            HEIGHT - ground_height - bottom_y
        )

        if bird_rect.colliderect(top_pipe_rect) or bird_rect.colliderect(bottom_pipe_rect):
            return True

    return False


def draw_ground():
    pygame.draw.rect(screen, (222, 184, 135), (0, HEIGHT - ground_height, WIDTH, ground_height))
    pygame.draw.rect(screen, GREEN, (0, HEIGHT - ground_height, WIDTH, 12))


def draw_score():
    score_text = font.render(str(score), True, WHITE)
    screen.blit(score_text, (WIDTH // 2 - score_text.get_width() // 2, 30))


def draw_game_over():
    game_over_text = font.render("GAME OVER", True, BLACK)
    restart_text = small_font.render("Press R to Restart", True, BLACK)

    screen.blit(
        game_over_text,
        (WIDTH // 2 - game_over_text.get_width() // 2, HEIGHT // 2 - 60)
    )
    screen.blit(
        restart_text,
        (WIDTH // 2 - restart_text.get_width() // 2, HEIGHT // 2)
    )


reset_game()

while True:
    clock.tick(FPS)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE and not game_over:
                bird_velocity = flap_strength

            if event.key == pygame.K_r and game_over:
                reset_game()

    if not game_over:
        bird_velocity += gravity
        bird_y += bird_velocity

        move_pipes()

        if check_collision():
            game_over = True

    screen.fill(SKY_BLUE)

    draw_pipes()
    draw_ground()
    draw_bird()
    draw_score()

    if game_over:
        draw_game_over()

    pygame.display.update()